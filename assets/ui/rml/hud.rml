<rml>
  <head>
    <title>Quantum Idle HUD</title>
    <link type="text/rcss" href="hud.rcss" />
  </head>
  <body>
    <div id="hud-root">
      <!-- Fixed HUD Resource Bar -->
      <div id="top-bar" class="hud-card resource-hud">
        <div class="resource-row">
          <div class="resource-chip" data-tooltip="Primary currency. Earned by observing quantum states.">
            <div class="resource-label">Qubits</div>
            <div class="resource-value quantum-blue" data-bind="qubits">0</div>
          </div>

          <div class="resource-chip wide" data-tooltip="Quantum stability. Low coherence reduces observation success.">
            <div class="chip-header">
              <div class="resource-label">Coherence</div>
              <div class="resource-value coherence-green" data-bind="coherence">100</div>
            </div>
            <div class="progress-shell">
              <div id="coherence-progress" class="progress-fill"></div>
            </div>
            <div class="progress-text" data-bind="coherence-percent">100%</div>
          </div>

          <div class="resource-chip" data-tooltip="Quantum connections. Used for advanced upgrades and research.">
            <div class="resource-label">Entanglement</div>
            <div class="resource-value entanglement-orange" data-bind="entanglement">0</div>
          </div>

          <div class="resource-chip" data-tooltip="Prestige currency from resets. Provides permanent production bonuses.">
            <div class="resource-label">Photons</div>
            <div class="resource-value photon-cyan" data-bind="photons">0</div>
          </div>

          <div class="resource-chip" data-tooltip="Collapse currency used for the highest-tier upgrades.">
            <div class="resource-label">Singularities</div>
            <div class="resource-value singularity-magenta" data-bind="singularities">0</div>
          </div>
        </div>
      </div>

      <!-- Main Content Area -->
      <div id="main-content">
        <div id="content-scroll" class="scroll-container">
          <!-- Stations View (Default) -->
          <div id="view-stations" class="view-panel active">
            <h2 class="view-title">Quantum Stations</h2>
            <div class="stations-grid">
              <div class="station-card">
                <h3 class="station-name">Observer Station</h3>
                <p class="station-desc">Collapse quantum states to generate qubits</p>
                <button class="btn-primary">Observe</button>
              </div>
              <div class="station-card">
                <h3 class="station-name">Coherence Stabilizer</h3>
                <p class="station-desc">Maintain quantum coherence</p>
                <div class="progress-bar">
                  <div class="progress-fill" style="width: 75%;"></div>
                </div>
              </div>
              <div class="station-card">
                <h3 class="station-name">Entanglement Network</h3>
                <p class="station-desc">Generate quantum entanglement</p>
                <p class="station-stat">Rate: <span data-bind="entanglement-rate">0.0</span>/s</p>
              </div>
            </div>
          </div>

          <!-- Research View -->
          <div id="view-research" class="view-panel">
            <h2 class="view-title">Research Tree</h2>
            <div class="research-grid">
              <!-- Research nodes will be dynamically generated here -->
            </div>
          </div>

          <!-- Upgrades/Buyables View -->
          <div id="view-upgrades" class="view-panel">
            <h2 class="view-title">Upgrades & Buyables</h2>
            <div class="buyables-grid">
              <!-- Buyable cards will be dynamically generated here -->
            </div>
          </div>

          <!-- Particle Collection View -->
          <div id="view-collection" class="view-panel">
            <h2 class="view-title">Particle Collection</h2>
            <div class="collection-layout">
              <div class="collection-column">
                <div id="collection-stats" class="collection-card"></div>

                <div class="collection-card">
                  <div class="card-header">
                    <h3 class="section-title">Discovery Tiers</h3>
                    <span class="helper-text" data-tooltip="Earn passive bonuses as you discover more particles">Progress</span>
                  </div>
                  <div id="discovery-tiers"></div>
                </div>

                <div class="collection-card">
                  <div class="card-header">
                    <h3 class="section-title">Equipped Particles</h3>
                    <span class="helper-text" data-tooltip="Equipped particles provide passive bonuses">Active bonuses</span>
                  </div>
                  <div id="equipped-particles"></div>
                </div>
              </div>

              <div class="collection-column">
                <div class="collection-card">
                  <div class="card-header">
                    <h3 class="section-title">Discovery Grid</h3>
                    <span class="helper-text" data-tooltip="Click a discovered particle to equip or unequip it">Equip & Manage</span>
                  </div>
                  <div id="particle-grid"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Combat View -->
          <div id="view-combat" class="view-panel">
            <h2 class="view-title">Combat System</h2>

            <!-- Combat Arena -->
            <div class="combat-arena">
              <!-- Player Section -->
              <div class="combatant-card player">
                <h3 class="combatant-name">Player Ship</h3>
                <div class="combatant-level">Level <span data-bind="player-level">1</span></div>
                <div class="hp-bar-container">
                  <div class="hp-bar">
                    <div class="hp-fill player-hp" style="width: 100%;"></div>
                  </div>
                  <div class="hp-text"><span data-bind="player-hp">100</span> / <span data-bind="player-max-hp">100</span> HP</div>
                </div>
                <div class="stats-grid">
                  <div class="stat-item">⚔️ ATK: <span data-bind="player-attack">10</span></div>
                  <div class="stat-item">🛡️ DEF: <span data-bind="player-defense">5</span></div>
                  <div class="stat-item">⚡ SPD: <span data-bind="player-speed">15</span></div>
                </div>
              </div>

              <!-- VS Indicator -->
              <div class="vs-indicator">VS</div>

              <!-- Enemy Section -->
              <div class="combatant-card enemy">
                <h3 class="combatant-name" data-bind="enemy-name">No Enemy</h3>
                <div class="combatant-level">Level <span data-bind="enemy-level">-</span></div>
                <div class="hp-bar-container">
                  <div class="hp-bar">
                    <div class="hp-fill enemy-hp" style="width: 100%;"></div>
                  </div>
                  <div class="hp-text"><span data-bind="enemy-hp">-</span> / <span data-bind="enemy-max-hp">-</span> HP</div>
                </div>
                <div class="stats-grid">
                  <div class="stat-item">⚔️ ATK: <span data-bind="enemy-attack">-</span></div>
                  <div class="stat-item">🛡️ DEF: <span data-bind="enemy-defense">-</span></div>
                  <div class="stat-item">⚡ SPD: <span data-bind="enemy-speed">-</span></div>
                </div>
              </div>
            </div>

            <!-- Combat Status -->
            <div class="combat-status">
              <div class="status-text" data-bind="combat-status">Not in combat</div>
            </div>

            <!-- Combat Actions -->
            <div class="combat-actions">
              <!-- Action buttons will be dynamically generated here -->
            </div>

            <!-- Combat Controls -->
            <div class="combat-controls">
              <button class="btn-secondary" data-action="toggle-auto">Auto-Battle: <span data-bind="auto-battle">OFF</span></button>
              <button class="btn-secondary" data-action="battle-speed">Speed: <span data-bind="battle-speed">1x</span></button>
            </div>

            <!-- Combat Log -->
            <div class="combat-log">
              <h3 class="log-title">Combat Log</h3>
              <div class="log-entries">
                <!-- Log entries will be dynamically generated here -->
              </div>
            </div>
          </div>

          <!-- Menu View -->
          <div id="view-menu" class="view-panel">
            <h2 class="view-title">Menu & Settings</h2>

            <div class="menu-grid">
              <!-- Game Controls Section -->
              <div class="menu-section">
                <h3 class="section-title">Game Controls</h3>
                <button class="btn-primary menu-btn" data-action="save-game">💾 Save Game</button>
                <button class="btn-secondary menu-btn" data-action="load-game">📂 Load Game</button>
                <button class="btn-secondary menu-btn" data-action="export-save">📤 Export Save</button>
                <button class="btn-secondary menu-btn" data-action="import-save">📥 Import Save</button>
              </div>

              <!-- Prestige Section -->
              <div class="menu-section">
                <h3 class="section-title">Prestige</h3>
                <div class="prestige-info">
                  <p class="info-text">Current Resets: <span class="highlight" data-bind="prestige-count">0</span></p>
                  <p class="info-text">Next Reset: <span class="highlight" data-bind="prestige-gain">+0</span> Photons</p>
                </div>
                <button class="btn-warning menu-btn" data-action="prestige-reset">🔄 Prestige Reset</button>
              </div>

              <!-- Statistics Section -->
              <div class="menu-section">
                <h3 class="section-title">Statistics</h3>
                <div class="stats-list">
                  <div class="stat-row">
                    <span class="stat-label">Total Qubits:</span>
                    <span class="stat-value" data-bind="total-qubits">0</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label">Play Time:</span>
                    <span class="stat-value" data-bind="play-time">0:00:00</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label">Research Completed:</span>
                    <span class="stat-value" data-bind="research-count">0</span>
                  </div>
                  <div class="stat-row">
                    <span class="stat-label">Battles Won:</span>
                    <span class="stat-value" data-bind="battles-won">0</span>
                  </div>
                </div>
              </div>

              <!-- Settings Section -->
              <div class="menu-section">
                <h3 class="section-title">Settings</h3>
                <div class="setting-row">
                  <span class="setting-label">Notifications:</span>
                  <button class="btn-toggle" data-action="toggle-notifications">
                    <span data-bind="notifications-state">ON</span>
                  </button>
                </div>
                <div class="setting-row">
                  <span class="setting-label">Auto-Save:</span>
                  <button class="btn-toggle" data-action="toggle-autosave">
                    <span data-bind="autosave-state">ON</span>
                  </button>
                </div>
                <div class="setting-row">
                  <span class="setting-label">Show Tooltips:</span>
                  <button class="btn-toggle" data-action="toggle-tooltips">
                    <span data-bind="tooltips-state">ON</span>
                  </button>
                </div>
              </div>

              <!-- About Section -->
              <div class="menu-section full-width">
                <h3 class="section-title">About</h3>
                <p class="about-text">
                  <strong>Quantum Idle</strong> - A quantum-themed incremental game<br/>
                  Version: <span data-bind="game-version">1.0.0</span><br/>
                  Built with RmlUi & SDL2
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Navigation Bar -->
      <div id="bottom-nav" class="bar-container">
        <div class="nav-buttons">
          <button class="nav-btn active" data-view="stations" data-tooltip="Stations (Press 1)">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">STATIONS</span>
          </button>
          <button class="nav-btn" data-view="research" data-tooltip="Research Tree (Press 2)">
            <span class="nav-icon">🔬</span>
            <span class="nav-label">RESEARCH</span>
          </button>
          <button class="nav-btn" data-view="upgrades" data-tooltip="Upgrades & Buyables (Press 3)">
            <span class="nav-icon">⬆️</span>
            <span class="nav-label">UPGRADES</span>
          </button>
          <button class="nav-btn" data-view="collection" data-tooltip="Particle Collection (Press 4)">
            <span class="nav-icon">🧬</span>
            <span class="nav-label">COLLECTION</span>
          </button>
          <button class="nav-btn" data-view="combat" data-tooltip="Combat System (Press 5)">
            <span class="nav-icon">⚔️</span>
            <span class="nav-label">COMBAT</span>
          </button>
          <button class="nav-btn" data-view="menu" data-tooltip="Settings & Menu (Press 6)">
            <span class="nav-icon">☰</span>
            <span class="nav-label">MENU</span>
          </button>
        </div>
      </div>

      <!-- Global Tooltip -->
      <div id="global-tooltip" class="tooltip">
        <div class="tooltip-content"></div>
      </div>

      <!-- Toast Notification Container -->
      <div id="toast-container"></div>
    </div>
  </body>
</rml>
