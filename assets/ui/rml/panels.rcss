body {
  font-family: 'Inter', sans-serif;
  color: #e8ecf7;
}

#panels-root {
  position: absolute;
  top: 70px;
  right: 24px;
  width: 420px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  pointer-events: none;
}

.panel-card {
  background: linear-gradient(180deg, rgba(12, 16, 32, 0.92), rgba(6, 8, 18, 0.92));
  border: 1px solid rgba(90, 138, 255, 0.35);
  border-radius: 12px;
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.3);
  padding: 16px;
  pointer-events: auto;
}

.panel-card.hidden {
  display: none;
}

.panel-header {
  margin-bottom: 10px;
}

.panel-header h2 {
  margin: 0 0 4px;
  font-size: 18px;
  letter-spacing: 0.5px;
}

.panel-subtitle {
  margin: 0;
  color: #9cb2d9;
  font-size: 13px;
}

.panel-content {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 10px;
  padding: 12px;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.achievement-card,
.upgrade-card,
.inventory-card {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  padding: 10px;
  background: rgba(255, 255, 255, 0.03);
}

.achievement-card .title {
  font-weight: 700;
  color: #f7f9ff;
}

.achievement-card .desc {
  margin: 4px 0 6px;
  color: #a8b6d4;
  font-size: 13px;
}

.status-badge {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  background: rgba(98, 255, 202, 0.18);
  color: #62ffca;
}

.status-badge.locked {
  background: rgba(255, 107, 129, 0.18);
  color: #ff6b81;
}

.progress-bar {
  position: relative;
  width: 100%;
  height: 10px;
  border-radius: 6px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7aa1ff, #8bffd8);
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
}

.stat-row {
  display: contents;
}

.stat-label {
  color: #98add2;
  font-size: 13px;
}

.stat-value {
  text-align: right;
  font-weight: 600;
}

.upgrade-card .title {
  font-weight: 700;
}

.upgrade-card .desc {
  color: #b6c6e5;
  font-size: 13px;
  margin: 4px 0 6px;
}

.upgrade-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #9cb2d9;
}

.ship-status {
  margin-bottom: 12px;
}

.status-label {
  font-size: 13px;
  color: #9cb2d9;
  margin-bottom: 4px;
}

.status-value {
  margin-top: 6px;
  font-weight: 700;
}

.ship-stats {
  margin: 12px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
}

.inventory {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.inventory-card .title {
  font-weight: 700;
}

.inventory-card .meta {
  font-size: 12px;
  color: #9cb2d9;
}
