body {
  font-family: "Inter", "Roboto", sans-serif;
  background: transparent;
}

#hud-root {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px;
  min-height: 100vh;
  box-sizing: border-box;
}

.panel {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background-color: rgba(10, 12, 18, 0.85);
  border-radius: 8px;
  padding: 12px;
  color: #e5e7eb;
  font-size: 14px;
}
