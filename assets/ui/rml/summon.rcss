#summon-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(5, 10, 20, 0.7);
  font-family: Inter, Arial, sans-serif;
}

.summon-panel {
  width: 900px;
  background: linear-gradient(145deg, #0f1525, #0b1020);
  border: 2px solid #2de1fc;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  padding: 18px;
  color: #dfe9ff;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.panel-title {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 1px;
}

.btn-icon {
  width: 36px;
  height: 36px;
  background: #1f2838;
  border: 1px solid #2de1fc;
  color: #9fb7ff;
  font-size: 18px;
}

.banner-row {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.banner-card {
  flex: 1;
  padding: 12px;
  background: #131a2b;
  border: 1px solid #2c3a55;
  color: #dfe9ff;
  text-align: left;
}

.banner-card.active {
  border-color: #ff7bff;
  box-shadow: 0 0 10px rgba(255, 123, 255, 0.4);
}

.banner-name {
  font-size: 18px;
  font-weight: 700;
}

.banner-meta {
  color: #8fb4ff;
  margin-top: 4px;
}

.currency-grid,
.pity-grid,
.actions-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}

.stat-card,
.pity-item {
  background: #0f1725;
  border: 1px solid #1f2a3f;
  padding: 10px;
}

.stat-label {
  color: #9fb7ff;
  font-size: 12px;
  letter-spacing: 0.5px;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
}

.pity-label {
  color: #7da0ff;
  margin-bottom: 4px;
}

.pity-value {
  font-weight: 700;
  color: #fff;
}

.actions-row {
  grid-template-columns: repeat(3, 1fr);
}

.btn-primary,
.btn-accent,
.btn-outline {
  padding: 12px;
  font-weight: 700;
  border: 1px solid #2de1fc;
  background: #10243a;
  color: #dfe9ff;
}

.btn-accent {
  background: linear-gradient(90deg, #5b2cff, #ff7bff);
  border-color: #ff7bff;
}

.btn-outline {
  background: transparent;
  border-style: dashed;
  color: #9fb7ff;
}

.results-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  min-height: 140px;
  background: #0c1322;
  border: 1px solid #1e2940;
  padding: 10px;
}

.result-card {
  padding: 8px;
  border: 1px solid #2c3a55;
  background: #121a2c;
}

.result-card .result-name {
  font-weight: 700;
  margin-bottom: 4px;
}

.result-card .result-rarity {
  font-size: 12px;
  letter-spacing: 0.5px;
  color: #9fb7ff;
}

.result-card.legendary { border-color: #ffb347; box-shadow: 0 0 10px rgba(255, 179, 71, 0.3); }
.result-card.epic { border-color: #c77dff; }
.result-card.rare { border-color: #66b3ff; }
.result-card.uncommon { border-color: #8bd17c; }
.result-card.common { border-color: #5c6780; }

.result-badge {
  margin-top: 6px;
  display: inline-block;
  padding: 2px 6px;
  border: 1px solid #ff7bff;
  color: #ffb3ff;
  font-size: 12px;
}

.summon-empty {
  grid-column: span 5;
  text-align: center;
  color: #7da0ff;
  padding: 12px 0;
}
